{
  "llm": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "apiKey": "YOUR_API_KEY_HERE",
    "baseUrl": "https://api.openai.com/v1"
  },
  "workspace": {
    "path": "./workspace"
  },
  "heartbeat": {
    "enabled": true,
    "intervalMinutes": 30
  },
  "agent": {
    "maxToolIterations": 10,
    "tokenBudget": 8000
  }
}
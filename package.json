{
  "name": "tinypaw",
  "version": "0.1.0",
  "description": "极简 Agent 框架 - Minimal Agent Framework",
  "type": "module",
  "main": "./dist/agent.js",
  "types": "./dist/agent.d.ts",
  "bin": {
    "tinypaw": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc --watch & node --watch dist/cli.js",
    "clean": "rm -rf dist",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "test:watch": "tsx --test --watch test/**/*.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text npm run test",
    "test:compiled": "node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "llm",
    "ai",
    "openclaw",
    "minimal",
    "typescript"
  ],
  "author": "pawofcat",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
